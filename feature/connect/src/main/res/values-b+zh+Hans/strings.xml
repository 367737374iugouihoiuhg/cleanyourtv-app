<?xml version="1.0" encoding="utf-8"?>
<!--
  Clean Your TV, :feature:connect。简体中文（Hans）字符串。
  与英文源文件的 <string name> 集合、数量、顺序一一对应。带参数的字符串使用 ICU MessageFormat
  命名参数（花括号），由应用的消息助手（android.icu.text.MessageFormat）格式化；无 printf 占位符。
  计数通过 plural 选择器处理。不翻译产品名、品牌/型号、adb 命令、Wi-Fi、Android、Google TV。
  界面：S1、S1b、S1c、S2a 到 S2d、S2x，"我看不到"面板，以及查找和连接电视的停止卡片。
-->
<resources>

    <!-- 共用按钮文字 -->
    <string name="action_back">返回</string>
    <string name="action_cancel">取消</string>
    <string name="action_ok">确定</string>

    <!-- S1 欢迎。overline 是产品名，与电视启动器上的一致。 -->
    <string name="welcome_overline" translatable="false">Clean Your TV</string>
    <string name="welcome_title">让你的电视焕然一新。</string>
    <string name="welcome_body">关掉杂乱，保留你常用的应用，还你一个清爽的主屏幕。只需五分钟，一切都能还原。</string>
    <string name="welcome_hero_cd">一个满是赞助内容栏的电视主屏幕，变成一个只在底部有四个应用的干净主屏幕</string>
    <string name="welcome_looking">正在你的 Wi-Fi 中查找电视……</string>
    <string name="welcome_found_one">已找到 {name}（{room}）</string>
    <string name="welcome_found_one_noroom">已找到 {name}</string>
    <string name="welcome_found_many">{count, plural, one {已找到 # 台电视} other {已找到 # 台电视}}</string>
    <string name="welcome_none_yet">还没有找到电视。别急，我们继续找。</string>
    <string name="welcome_start">开始</string>
    <string name="welcome_returning">我之前设置过电视</string>

    <!-- S1b 是哪台电视？ -->
