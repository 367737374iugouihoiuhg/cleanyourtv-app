    <!-- allow_body 中以 text.primary 显示的两个部分；每一部分都必须在 allow_body 中原样出现。 -->
    <string name="allow_body_emphasis_always">"始终允许"</string>
    <string name="allow_body_emphasis_ok">确定。</string>
    <string name="allow_code_label">电视上代码的结尾是</string>
    <string name="allow_code_caption">那就是这台手机。</string>
    <string name="allow_waiting">正在等待你在电视上点按……</string>
    <string name="allow_still_waiting">仍在等待你在电视上按确定。</string>
    <string name="allow_trusted">已信任</string>
    <string name="allow_dont_see">我在电视上看不到它</string>
    <string name="allow_art_cd">电视上的"允许 USB 调试"对话框。指纹结尾为 {tail}。</string>

    <!-- S2c 面板：我在电视上看不到它（UX 4.4） -->
    <string name="notseen_title">我在电视上看不到它</string>
    <string name="notseen_hidden">这个对话框可能被另一个界面挡住了。请按遥控器上的主页键，然后按一次返回。如果还是没有，我们会再问一次电视。</string>
    <string name="notseen_cancelled">如果有人点了取消：请在电视上先把 USB 调试关掉再打开，然后点"再问一次电视"。</string>
    <string name="notseen_greyed">如果电视上的"始终允许"是灰的，只按确定也可以；下次我们会再问一次。</string>
    <string name="notseen_ask_again">再问一次电视</string>
    <string name="notseen_asking">正在再问一次电视……</string>
    <string name="notseen_restart">电视不接受这台手机。在某些型号上，如果电视还没启动完就开启了调试，就会这样。请重启电视，再次开启调试，然后回来。</string>
    <string name="notseen_restarted">我已经重启了</string>

    <!-- S2d 已连接，以及身份确认"这是你的电视吗？"（D38） -->
    <string name="connected_title">已连接到 {tv}</string>
    <string name="connected_cd">已连接</string>
    <string name="identity_question">这是你的电视吗？</string>
    <string name="identity_detail">{name}，序列号结尾 {serial}</string>
    <string name="identity_body">请确认画面与你电视现在显示的内容一致。</string>
    <string name="identity_screenshot_cd">你的电视现在显示的内容</string>
    <string name="identity_yes">是的，这是我的</string>
    <string name="identity_no">不是</string>

    <!-- S2x 需要配对（D9）。三条命令是代码，不翻译。 -->
    <string name="pairing_title">这台电视需要配对码</string>
    <string name="pairing_body">这个版本还无法输入配对码，下一个版本可以。如果你有电脑，请用 adb 配对一次并运行 adb tcpip 5555，然后回来；剩下的交给手机。</string>
    <string name="pairing_show_steps">教我电脑上的步骤</string>
    <string name="pairing_steps_title">在电脑上配对一次</string>
    <string name="pairing_steps_intro">在电视上打开"开发者选项" > "无线调试" > "使用配对码配对设备"。然后在电脑上依次运行这三条命令。</string>
    <string name="pairing_steps_cmd_pair" translatable="false">adb pair ADDRESS:PAIR_PORT</string>
    <string name="pairing_steps_cmd_connect" translatable="false">adb connect ADDRESS:CONNECT_PORT</string>
    <string name="pairing_steps_cmd_tcpip" translatable="false">adb -s ADDRESS:CONNECT_PORT tcpip 5555</string>
    <string name="pairing_steps_note">请使用电视显示的地址、端口和六位配对码。最后一条命令运行完，就回到这个应用。电视重启后，用电视当时显示的端口再次运行最后两条命令即可；无需再次配对。</string>

    <!-- 停止：未找到电视（UX 4.1，不显示 Wi-Fi 名称，D19） -->
    <string name="stop_tv_not_found_title">还没找到电视</string>
    <string name="stop_tv_not_found_body">请确认电视已开机，并和这台手机连在同一个 Wi-Fi 上。电视唤醒后可能需要一分钟才会出现。</string>
    <string name="stop_tv_not_found_primary">继续查找</string>
    <string name="stop_tv_not_found_secondary">输入电视的地址</string>
    <string name="stop_tv_not_found_tertiary">帮助</string>
    <string name="stop_tv_not_found_help_title">电视可能不出现的原因</string>
    <string name="stop_tv_not_found_help_isolation">访客 Wi-Fi，或让设备相互隔离的路由器。请在路由器里找到"AP 隔离"或"客户端隔离"并把它关掉。</string>
    <string name="stop_tv_not_found_help_ethernet">电视用有线网络，而手机用 Wi-Fi。在大多数路由器上这没问题，但有些会把两者隔离。直接输入电视的地址可以绕过。</string>
    <string name="stop_tv_not_found_help_mesh">带独立访客网络的 Mesh 组网。请把手机连到主网络。</string>

    <!-- 停止：网络不对（UX 4.2，配合 D19 文字） -->
    <string name="stop_wrong_network_title">手机和电视连的不是同一个网络</string>
    <string name="stop_wrong_network_body">上次发现电视时它在另一个网络上。请连到电视所在的 Wi-Fi，我们继续。</string>
    <string name="stop_wrong_network_primary">打开 Wi-Fi 设置</string>
    <string name="stop_wrong_network_secondary">我连的没问题，再看一次</string>
    <string name="stop_wrong_network_off_title">这台手机没连 Wi-Fi</string>
    <string name="stop_wrong_network_off_body">Wi-Fi 已关闭。只能通过同一个 Wi-Fi 连到电视。</string>

    <!-- 停止：身份已改变（D37） -->
    <string name="stop_identity_changed_title">这个地址上应答的是另一台电视</string>
    <string name="stop_identity_changed_body">这个地址上的电视不是我们设置为 {name} 的那台。它的地址可能变了，或被另一台电视占用。我们在改动任何东西之前就停止了。</string>
    <string name="stop_identity_changed_primary">再找一次</string>
    <string name="stop_identity_changed_secondary">返回</string>

    <!-- 停止：缺少 shell v2（F1） -->
    <string name="stop_tv_not_supported_title">这台电视还不能用手机设置</string>
    <string name="stop_tv_not_supported_body">这台电视的调试连接太基础，手机无法安全地做改动，所以我们在动任何东西之前就停止了。电视上没有任何改动。</string>
    <string name="stop_tv_not_supported_primary">返回</string>

</resources>
