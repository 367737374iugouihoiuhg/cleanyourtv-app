    <string name="picker_primary">使用 {name}</string>
    <string name="picker_tertiary">输入电视的地址</string>

    <!-- S1c 输入电视地址（面板）：文字见 ui/design（AddressEntry） -->

    <!-- S2a 让手机接入（步骤） -->
    <string name="door_title">让手机接入</string>
    <string name="door_body">拿起电视遥控器。这一步大约要一分钟，也是唯一稍显麻烦的地方。</string>
    <string name="door_step_cd">第 {current} 步，共 {total} 步</string>
    <string name="door_next">下一步</string>
    <string name="door_menu_names_vary">你电视上的菜单名称可能略有不同。</string>
    <string name="door_same_wifi">手机和电视必须连同一个 Wi-Fi。</string>
    <string name="door_waiting">正在等待电视……</string>
    <string name="door_connecting">正在连接……</string>
    <string name="door_still_waiting">仍在等待。USB 调试已开启了吗？有些电视还需要开启网络调试。</string>
    <string name="door_still_waiting_show_me">教我操作</string>
    <string name="door_change_model">不是 {model}？更换型号</string>
    <string name="door_change_model_generic">不是这台电视？更换型号</string>
