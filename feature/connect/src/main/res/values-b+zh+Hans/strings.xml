    <string name="door_not_this_tv">不是这台电视？输入电视的地址</string>
    <string name="door_brand_prompt">是哪个品牌？</string>
    <string name="door_brand_xiaomi">小米</string>
    <string name="door_brand_tcl">TCL</string>
    <string name="door_brand_sony">索尼</string>
    <string name="door_brand_hisense">海信</string>
    <string name="door_brand_philips">飞利浦</string>
    <string name="door_brand_google">Google</string>
    <string name="door_brand_amazon">Amazon</string>
    <string name="door_brand_other">其他</string>
    <!-- 选择 TCL 之后：中国大陆版 TCL 固件与 TCL 的 Android TV 或 Google TV 需要不同的步骤。 -->
    <string name="door_tcl_menus_prompt">电视显示的是哪种菜单？</string>
    <string name="door_tcl_menus_global">英文或我的语言的菜单</string>
    <string name="door_tcl_menus_chinese">中文菜单</string>
    <!-- 0.3.6：电视的端口已应答，但连接失败；{kind} 是一个简短代码，例如 unreachable -->
    <string name="door_connect_failed_title">电视已应答，但这台手机无法连接</string>
    <string name="door_connect_failed_body">连接失败（{kind}）。只要停留在这个界面，我们就会不断重试。</string>
    <string name="door_connect_failed_hint">如果电脑上的 ADB 可以连接，但这个应用连不上电视，可能是手机上有东西挡住了：某个应用的网络限制（MIUI、三星）、VPN、私密 DNS 或移动数据。先暂时关掉它，再试一次。</string>
    <!-- 0.4.8：电视拒绝了连接（refused）：它的调试端口上没有程序在监听。{kind} 是简短代码 refused -->
    <string name="door_connect_refused_title">电视上的调试已关闭</string>
    <string name="door_connect_refused_body">电视拒绝了连接（{kind}），说明它的调试是关闭的。设置结束时我们会有意把它关掉，所以对之前设置过的电视来说这是正常的。</string>
    <string name="door_connect_refused_hint">要重新开启：在电视上打开"设置"，再进入"设备偏好设置"或"系统"，然后进入"开发者选项"，开启 USB 调试。只要停留在这个界面，我们就会不断重试。</string>
    <string name="door_copy_error">复制错误信息</string>
    <string name="door_error_copied">已复制。请粘贴到你的问题反馈里。</string>
    <!-- 0.4.6：在连接失败下方；打开 GitHub 表单并预先填好手机这一侧的信息。所有报告按钮的文字。 -->
    <string name="connect_report">报告问题</string>
    <string name="door_unknown_note">我们之前没见过这台一模一样的电视。步骤通常是一样的。</string>

    <!-- 按平台家族划分的 S2a 步骤卡片（UX 2 表）。给译者的提示：请与电视自身的菜单名称保持一致。 -->
    <!-- Android TV 9 到 11 -->
    <string name="family_atv_step1">在电视上打开"设置"（右上角的齿轮），再进入"设备偏好设置" > "关于"。在"版本号"上按确定七次，直到电视提示"你现在是开发者"。</string>
    <string name="family_atv_step2">返回上一级。打开"开发者选项"，开启 USB 调试。如果电视还显示"网络调试"或"ADB 调试"，也一并开启。</string>
    <string name="family_atv_step3">让电视停留在这个界面。你的手机会自动连接。</string>
    <string name="family_atv_extra_shield">在 Shield 上，关键是"网络调试"这一项。</string>
    <!-- Google TV 12 到 14 -->
    <string name="family_gtv_step1">在电视上打开"设置"，再进入"系统" > "关于"。在"Android TV 系统版本"上按确定七次，直到电视提示"你现在是开发者"。</string>
    <string name="family_gtv_step2">返回上一级。打开"系统" > "开发者选项"，开启 USB 调试，然后再开启无线调试。</string>
    <string name="family_gtv_step3">让电视停留在这个界面。你的手机会自动连接。</string>
    <!-- Fire TV（Fire OS 7） -->
    <string name="family_fire_step1">在电视上打开"设置" > "我的 Fire TV" > "关于"。连续选择设备名称七次，直到电视提示"你现在是开发者"。</string>
    <string name="family_fire_step2">返回上一级。打开"开发者选项"，开启 ADB 调试。</string>
    <string name="family_fire_step3">让电视停留在这个界面。你的手机会自动连接。</string>
    <!-- 中国大陆版 TCL（Android 9） -->
    <string name="family_tcl_step1">在电视上打开"设置" > "关于" > 本机信息，然后用遥控器依次按 上、下、左、右。</string>
    <string name="family_tcl_step2">会出现一个带有地址的小"ADB"窗口。保持它开着。</string>
    <string name="family_tcl_step3">让电视停留在这个界面。你的手机会自动连接。</string>
    <!-- 中国大陆以外的 TCL（菜单为英文或用户语言）：在 Android TV 步骤的基础上，第 1、2 步再加这几行 -->
    <string name="family_tcl_extra_gtv_step1">在 Google TV 上：进入"系统" > "关于"，然后在"Android TV 系统版本"上按确定七次。</string>
    <string name="family_tcl_extra_gtv">在 Google TV 上，还要开启无线调试。</string>
    <!-- 未知品牌：通用的 Android TV 路径 -->
    <string name="family_unknown_step1">在电视上打开"设置"（右上角的齿轮），再进入"设备偏好设置" > "关于"。在"版本号"上按确定七次，直到电视提示"你现在是开发者"。</string>
    <string name="family_unknown_step2">返回上一级。打开"开发者选项"，开启 USB 调试。如果电视还显示"网络调试"或"ADB 调试"，也一并开启。</string>
    <string name="family_unknown_step3">让电视停留在这个界面。你的手机会自动连接。</string>

    <!-- S2a 档案横幅（UX 2 和 4.15） -->
    <string name="banner_fire">在 Fire TV 上，我们可以关闭广告和跟踪，但会保留它自己的主屏幕。你依然能享受清理效果。</string>
    <string name="banner_tcl">这台电视会保留自己的主屏幕（TCL 不允许使用其他主屏幕）。你依然能享受清理效果。</string>
    <string name="banner_mibox_usb">调试开启期间，这台设备会关闭它的 USB 接口。USB 音箱或 U 盘会停止工作，直到我们完成（结束时我们会再把调试关掉）。</string>

    <!-- S2c 请看电视（允许） -->
